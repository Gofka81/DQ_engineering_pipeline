# DQ Pipeline — environment configuration
# Copy this file to .env and fill in the values marked CHANGE THIS.
# Everything else can be left as-is for a local Docker setup.

# PostgreSQL — leave as-is
POSTGRES_USER=prefect
POSTGRES_PASSWORD=prefect
POSTGRES_DB=prefect
POSTGRES_HOST=postgres
BACKEND_DB=backend

# MinIO — leave as-is
# MINIO_PUBLIC_ENDPOINT is what your browser uses to download cleaned files.
# Change the IP if running on a remote machine (e.g. http://10.0.0.5:9000)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=minio:9000
MINIO_PUBLIC_ENDPOINT=http://localhost:9000

# Redis — leave as-is
REDIS_PORT=6379
REDIS_JOBS_QUEUE=jobs

# Auth — CHANGE THIS
# Generate a secret key with: openssl rand -hex 32
SECRET_KEY=CHANGE_THIS_run_openssl_rand_-hex_32
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# General
ENVIRONMENT=development
CORS_ORIGINS=*
MAX_FILE_SIZE_MB=200

# Groq API key — free at https://console.groq.com/
# Leave empty to run without LLM enrichment (deterministic recommendations only)
# CHANGE THIS to get semantic notes, column rename suggestions, transform hints
LLM_API_KEY=

# Frontend API URL
# This is baked into the JS bundle at build time.
# It must be the URL your browser uses to reach the backend.
#   Running everything in Docker:   http://localhost:8020
#   Running on a machine: http://<machine-ip>:8020
VITE_API_URL=http://localhost:8020

# Prefect UI URL — leave as-is for Docker on this machine
# Change the IP if running on a remote machine
PREFECT_UI_API_URL=http://localhost:4200/api
